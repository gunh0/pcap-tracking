{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/health": {
            "get": {
                "description": "Check if the API service is running",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check endpoint",
                "responses": {
                    "200": {
                        "description": "Health status",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/interfaces": {
            "get": {
                "description": "Retrieve list of available network interfaces for packet capture",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "interfaces"
                ],
                "summary": "Get network interfaces",
                "responses": {
                    "200": {
                        "description": "List of network interfaces",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/api/v1/stats": {
            "get": {
                "description": "Retrieve current packet capture statistics for all monitored interfaces",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "statistics"
                ],
                "summary": "Get packet capture statistics",
                "responses": {
                    "200": {
                        "description": "Packet capture statistics",
                        "schema": {
                            "$ref": "#/definitions/models.SystemStats"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.PacketStats": {
            "type": "object",
            "properties": {
                "bytesPerSec": {
                    "type": "integer"
                },
                "bytesTotal": {
                    "type": "integer"
                },
                "interface": {
                    "type": "string"
                },
                "packetsPerSec": {
                    "type": "integer"
                },
                "packetsTotal": {
                    "type": "integer"
                },
                "protocolStats": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer",
                        "format": "int64"
                    }
                },
                "timestamp": {
                    "type": "string"
                }
            }
        },
        "models.SystemStats": {
            "type": "object",
            "properties": {
                "activeInterfaces": {
                    "type": "integer"
                },
                "interfaceStats": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/models.PacketStats"
                    }
                },
                "timestamp": {
                    "type": "string"
                },
                "totalBytes": {
                    "type": "integer"
                },
                "totalPackets": {
                    "type": "integer"
                },
                "uptime": {
                    "description": "Duration in nanoseconds",
                    "type": "integer"
                }
            }
        }
    }
}